---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/partials/Breadcrumbs.astro';
import { site } from '@/lib/site';
---

<BaseLayout title="Privacy Policy" description={`Privacy policy for ${site.name}.`}>
  <div class="container-prose py-10 md:py-14">
    <Breadcrumbs
      items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]}
    />
    <article class="prose-formula mt-8">
      <h1>Privacy Policy</h1>
      <p class="lead">
        {site.name} is a static site. It does not collect personal information,
        set tracking cookies, or run profiling analytics.
      </p>

      <h2>What we don't collect</h2>
      <ul>
        <li>No accounts or logins.</li>
        <li>No third-party advertising scripts.</li>
        <li>No tracking pixels or fingerprinting.</li>
      </ul>

      <h2>What may be logged</h2>
      <p>
        The host may keep standard request logs (IP, user agent, URL, timestamp)
        for security and reliability. Logs are not used for profiling.
      </p>

      <h2>Third-party fonts</h2>
      <p>
        The site loads fonts from Google Fonts, so a request hits Google's servers
        on first load. Block external font requests if that's a concern.
      </p>

      <h2>Contact</h2>
      <p>
        Questions? Reach out via
        <a href={site.author.github} target="_blank" rel="noopener">GitHub</a>.
      </p>
    </article>
  </div>
</BaseLayout>
