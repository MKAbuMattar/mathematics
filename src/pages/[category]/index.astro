---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/partials/Breadcrumbs.astro';
import { categories } from '@/lib/categories';
import { ArrowRight } from 'lucide-react';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const Icon = category.icon;
---

<BaseLayout title={category.title} description={category.description}>
  <div class="container-page py-6 md:py-10">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/' },
        { label: category.title },
      ]}
    />

    <header class="mt-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="flex items-center gap-4">
        <span
          class={`flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br ${category.accent} text-white shadow-sm`}
        >
          <Icon size={26} />
        </span>
        <div>
          <h1 class="text-3xl font-semibold tracking-tight md:text-4xl">
            {category.title}
          </h1>
          <p class="mt-1 max-w-2xl text-text-muted dark:text-text-muted-dark">
            {category.description}
          </p>
        </div>
      </div>
      <span class="text-sm text-text-subtle dark:text-text-subtle-dark">
        {category.topics.length} reference pages
      </span>
    </header>

    <section class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        category.topics.map((topic) => (
          <a
            href={`/${category.slug}/${topic.slug}`}
            class="group flex flex-col justify-between gap-3 rounded-xl border border-border bg-surface-2 p-5 transition-all hover:border-primary hover:bg-primary-soft dark:border-border-dark dark:bg-surface-2-dark dark:hover:bg-primary-soft-dark/30 dark:hover:border-primary cursor-pointer"
          >
            <div>
              <h2 class="text-base font-semibold tracking-tight group-hover:text-primary">
                {topic.title}
              </h2>
              <p class="mt-1 text-sm text-text-muted dark:text-text-muted-dark">
                {topic.description}
              </p>
            </div>
            <div class="inline-flex items-center gap-1 text-xs font-medium text-primary opacity-0 transition-opacity group-hover:opacity-100">
              Open <ArrowRight size={12} />
            </div>
          </a>
        ))
      }
    </section>
  </div>
</BaseLayout>
