---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowLeft } from 'lucide-react';
---

<BaseLayout title="Page not found">
  <div class="container-page flex min-h-[60vh] flex-col items-center justify-center py-16 text-center">
    <p class="font-mono text-sm tracking-widest text-primary">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight md:text-5xl">
      Lost in the function space.
    </h1>
    <p class="mt-3 max-w-md text-text-muted dark:text-text-muted-dark">
      Not here. Head back home and try again.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-medium text-white transition-colors hover:bg-primary-hover cursor-pointer"
    >
      <ArrowLeft size={16} /> Back home
    </a>
  </div>
</BaseLayout>
