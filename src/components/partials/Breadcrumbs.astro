---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="flex flex-wrap items-center gap-1.5 text-sm text-text-muted dark:text-text-muted-dark">
    {
      items.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && (
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              class="h-3.5 w-3.5 text-text-subtle dark:text-text-subtle-dark"
              aria-hidden="true"
            >
              <polyline points="9 18 15 12 9 6" />
            </svg>
          )}
          {item.href ? (
            <a
              href={item.href}
              class="hover:text-primary transition-colors"
            >
              {item.label}
            </a>
          ) : (
            <span
              aria-current="page"
              class="font-medium text-text dark:text-text-dark"
            >
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
