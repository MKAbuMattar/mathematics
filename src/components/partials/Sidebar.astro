---
import type { Category } from '@/lib/categories';

interface Props {
  category: Category;
  activeTopicSlug?: string;
}

const { category, activeTopicSlug } = Astro.props;
const Icon = category.icon;
---

<aside class="lg:sticky lg:top-20 lg:self-start lg:h-[calc(100vh-6rem)] lg:overflow-y-auto">
  <details class="lg:open:!block group" open>
    <summary
      class="flex cursor-pointer items-center justify-between rounded-lg border border-border bg-surface-2 px-4 py-3 lg:hidden dark:border-border-dark dark:bg-surface-2-dark"
    >
      <span class="flex items-center gap-2 text-sm font-medium">
        <Icon size={16} />
        {category.title} topics
      </span>
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="h-4 w-4 transition-transform group-open:rotate-180"
      >
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </summary>

    <nav class="mt-3 lg:mt-0 lg:block" aria-label={`${category.title} topics`}>
      <p
        class="hidden lg:flex items-center gap-2 px-2 pb-3 text-xs font-semibold uppercase tracking-wider text-text-subtle dark:text-text-subtle-dark"
      >
        <Icon size={14} />
        {category.title}
      </p>
      <ul class="space-y-0.5">
        {
          category.topics.map((topic) => {
            const isActive = activeTopicSlug === topic.slug;
            return (
              <li>
                <a
                  href={`/${category.slug}/${topic.slug}`}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'block rounded-md px-3 py-2 text-sm transition-colors',
                    isActive
                      ? 'bg-primary-soft font-medium text-primary dark:bg-primary-soft-dark/40'
                      : 'text-text-muted hover:bg-surface-2 hover:text-text dark:text-text-muted-dark dark:hover:bg-surface-2-dark dark:hover:text-text-dark',
                  ]}
                >
                  {topic.title}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </details>
</aside>
