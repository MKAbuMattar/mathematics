---
import { site } from '@/lib/site';
import { Pencil, AlertCircle } from 'lucide-react';

interface Props {
  filePath: string;
  pagePath: string;
  topicTitle: string;
  categoryTitle: string;
}

const { filePath, pagePath, topicTitle, categoryTitle } = Astro.props;

const editUrl = `${site.repo}/edit/${site.branch}/${filePath}`;

const issueBody = `**Page:** \`${pagePath}\`
**Topic:** ${categoryTitle} — ${topicTitle}
**File:** \`${filePath}\`

### What's wrong

<!-- Paste the incorrect LaTeX or describe the issue. Example: the modulus formula uses b^4 instead of b^2 -->

### What it should be

<!-- Correct LaTeX or wording -->

### Source

<!-- Textbook, Wikipedia, or other reference (optional) -->
`;

const issueUrl =
  `${site.repo}/issues/new` +
  `?title=${encodeURIComponent(`Math error on ${pagePath}`)}` +
  `&labels=bug%3Amath` +
  `&body=${encodeURIComponent(issueBody)}`;
---

<aside
  class="mt-12 flex flex-col gap-3 rounded-xl border border-border bg-surface-2 p-5 dark:border-border-dark dark:bg-surface-2-dark sm:flex-row sm:items-center sm:justify-between"
  aria-label="Page actions"
>
  <div>
    <p class="text-sm font-semibold">See an error?</p>
    <p class="mt-1 text-sm text-text-muted dark:text-text-muted-dark">
      This page is open source. Fix a typo or report a wrong formula.
    </p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a
      href={editUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1.5 rounded-md border border-border bg-surface px-3 py-2 text-sm font-medium transition-colors hover:border-primary hover:text-primary dark:border-border-dark dark:bg-surface-dark cursor-pointer"
    >
      <Pencil size={14} aria-hidden />
      Edit on GitHub
    </a>
    <a
      href={issueUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center gap-1.5 rounded-md bg-primary px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-primary-hover cursor-pointer"
    >
      <AlertCircle size={14} aria-hidden />
      Report an error
    </a>
  </div>
</aside>
