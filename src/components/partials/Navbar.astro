---
import { categories } from '@/lib/categories';
import { site } from '@/lib/site';
import ThemeToggle from '@/components/ui/ThemeToggle.tsx';
import { Sigma } from 'lucide-react';

const pathname = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header
  class="sticky top-0 z-40 border-b border-border bg-surface/80 backdrop-blur-md dark:border-border-dark dark:bg-surface-dark/80"
>
  <div class="container-page flex h-16 items-center gap-6">
    <a
      href="/"
      class="flex items-center gap-2 font-semibold tracking-tight"
      aria-label={site.name}
    >
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-white">
        <Sigma size={18} strokeWidth={2.5} />
      </span>
      <span class="hidden sm:inline">{site.name}</span>
    </a>

    <nav
      class="hidden md:flex flex-1 items-center gap-1"
      aria-label="Primary"
    >
      {
        categories.map((cat) => (
          <a
            href={`/${cat.slug}`}
            class:list={[
              'rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive(`/${cat.slug}`)
                ? 'text-primary bg-primary-soft dark:bg-primary-soft-dark/40'
                : 'text-text-muted hover:text-text hover:bg-surface-2 dark:text-text-muted-dark dark:hover:text-text-dark dark:hover:bg-surface-2-dark',
            ]}
          >
            {cat.title}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <ThemeToggle client:load />
      <a
        href={site.repo}
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex h-9 w-9 items-center justify-center rounded-md text-text-muted hover:bg-surface-2 hover:text-text dark:text-text-muted-dark dark:hover:bg-surface-2-dark dark:hover:text-text-dark transition-colors"
        aria-label="Source on GitHub"
        title="Source on GitHub"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55 0-.27-.01-.99-.02-1.94-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.74.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.84 1.18 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.15 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.8.55C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"
          ></path>
        </svg>
      </a>
      <button
        type="button"
        id="nav-mobile-toggle"
        class="md:hidden inline-flex h-9 w-9 items-center justify-center rounded-md text-text-muted hover:bg-surface-2 dark:text-text-muted-dark dark:hover:bg-surface-2-dark transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="nav-mobile"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
          <line x1="4" y1="6" x2="20" y2="6" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="18" x2="20" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="nav-mobile"
    class="md:hidden hidden border-t border-border bg-surface dark:border-border-dark dark:bg-surface-dark"
    aria-label="Mobile primary"
  >
    <div class="container-page py-3 flex flex-col">
      {
        categories.map((cat) => (
          <a
            href={`/${cat.slug}`}
            class:list={[
              'block rounded-md px-3 py-2 text-sm font-medium transition-colors',
              isActive(`/${cat.slug}`)
                ? 'text-primary bg-primary-soft dark:bg-primary-soft-dark/40'
                : 'text-text-muted hover:bg-surface-2 dark:text-text-muted-dark dark:hover:bg-surface-2-dark',
            ]}
          >
            {cat.title}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('nav-mobile-toggle');
  const menu = document.getElementById('nav-mobile');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
